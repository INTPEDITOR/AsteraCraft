extends SceneTree
func _initialize() -> void:
	var args=OS.get_cmdline_user_args()
	assert(not args.is_empty() and ProjectSettings.load_resource_pack(args[0],true))
	assert(ResourceLoader.exists("res://assets/terrain_rock_tiles_20261024.png"))
	var source=JSON.parse_string(FileAccess.get_file_as_string("res://data/source_terrain_semantics_20261024.json"))
	assert(source.maps.size()==3 and source.maps[0].water_minitiles==13367 and source.maps[2].water_minitiles==31456)
	assert(ResourceLoader.exists("res://scripts/player_overlay_canvas.gd"))
	assert(ResourceLoader.exists("res://assets/ui/hud_citrus_wood_new_20261024.png"))
	assert(ResourceLoader.exists("res://assets/startup/title_three_factions_approved_20261024.png"))
	assert(ResourceLoader.exists("res://assets/startup/zipza_games_original_20261024.png"))
	assert(ResourceLoader.exists("res://startup.tscn"))
	assert(FileAccess.file_exists("res://data/windows_updater.txt"))
	assert(ResourceLoader.exists("res://scripts/game_updater.gd"))
	var channel=JSON.parse_string(FileAccess.get_file_as_string("res://data/update_channel.json"))
	assert(channel.tag=="feedback3-20261024" and channel.built_at_unix>0)
	assert(ResourceLoader.exists("res://assets/fonts/LevelUp-Regular.ttf"))
	assert(FileAccess.file_exists("res://assets/fonts/OFL-LevelUp.txt"))
	var cloud=JSON.parse_string(FileAccess.get_file_as_string("res://data/art_nuclear_stable_20261024.json"))
	assert("nuclear_stable_20261024" in str(cloud.effects.nuclear.file))
	var data=JSON.parse_string(FileAccess.get_file_as_string("res://data/game.json"))
	var stim=data.abilities.filter(func(item):return item.id=="stim")[0]
	assert(stim.kinds.size()==2 and int(stim.kinds[0])==1 and int(stim.kinds[1])==2 and int(stim.hp_cost)==10)
	var passives=data.research.filter(func(item):return item.has("unit_kind"))
	assert(passives.size()==10)
	for item in passives:assert(ResourceLoader.exists("res://assets/ui/passive_upgrades_20261024/"+item.id+".png"))
	assert(not FileAccess.file_exists("res://work/font-candidates-20261024/DoHyeon-Regular.ttf"))
	assert(not FileAccess.file_exists("res://build/rock-terrain-20261024/source-reference/original-map-0.png"))
	assert(not FileAccess.file_exists("res://build/terrain-metadata/jungle.vr4"))
	print("FEEDBACK3_PACK terrain/semantic masks/player overlay/new wood HUD/approved title/LevelUp/OFL/new nuclear/stim present; source pixels and unselected fonts excluded")
	quit()
